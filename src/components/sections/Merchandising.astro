
---
interface Producto {
  id: number;
  nombre: string;
  descripcion: string;
  precio: string;
  imagen: string;
  categoria: string;
}

let productos: Producto[] = [];
let error = false;

try {
  const response = await fetch('http://localhost:4321/api/productos');

  if (!response.ok) {
    throw new Error('No se pudieron obtener los productos');
  }

  productos = await response.json();
} catch (e) {
  console.error('Error al cargar merchandising:', e);
  error = true;
}

function formatearPrecio(precio: string) {
  return Number(precio).toLocaleString('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  });
}
---

<section class="merch-section" id="merchandising">
  <div class="merch-container">
    <div class="merch-heading">
      <span class="section-eyebrow">UNIVERSO MUSE</span>
      <h2>Tienda Oficial</h2>
      <p>
        Explorá productos inspirados en la identidad visual y musical
        de Muse.
      </p>
    </div>

    {error ? (
      <p class="merch-message">
        No pudimos cargar los productos. Intentá nuevamente más tarde.
      </p>
    ) : productos.length > 0 ? (
      <div class="merch-grid">
        {productos.map((producto) => (
          <article class="merch-card">
            <div class="merch-image">
              <img
                src={producto.imagen}
                alt={producto.nombre}
                loading="lazy"
              />
              <span class="merch-category">
                {producto.categoria}
              </span>
            </div>

            <div class="merch-info">
              <h3>{producto.nombre}</h3>
              <p>{producto.descripcion}</p>

              <div class="merch-bottom">
                <span class="merch-price">
                  {formatearPrecio(producto.precio)}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="merch-message">
        No hay productos disponibles por el momento.
      </p>
    )}

    <div class="merch-footer">
      {productos.length} PRODUCTOS DISPONIBLES
    </div>
  </div>
</section>

<style>
  .merch-section {
    padding: 100px 24px;
    background: #090909;
    color: #f5f5f5;
  }

  .merch-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .merch-heading {
    max-width: 650px;
    margin-bottom: 55px;
  }

  .section-eyebrow {
    color: #e31b23;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .merch-heading h2 {
    margin: 16px 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .merch-heading p {
    color: #a3a3a3;
    line-height: 1.7;
  }

  .merch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .merch-card {
    overflow: hidden;
    background: #141414;
    border: 1px solid rgb(141 169 204 / 15%);
    border-radius: 8px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .merch-card:hover {
    transform: translateY(-5px);
    border-color: rgb(227 27 35 / 60%);
  }

  .merch-image {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: #1b1b1b;
  }

  .merch-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .merch-card:hover .merch-image img {
    transform: scale(1.05);
  }

  .merch-category {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 7px 12px;
    background: rgb(9 9 9 / 85%);
    color: #e31b23;
    font-size: 0.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .merch-info {
    padding: 22px;
  }

  .merch-info h3 {
    margin: 0 0 12px;
    font-size: 1.05rem;
  }

  .merch-info p {
    min-height: 45px;
    margin: 0;
    color: #a3a3a3;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .merch-bottom {
    margin-top: 22px;
    padding-top: 17px;
    border-top: 1px solid rgb(141 169 204 / 15%);
  }

  .merch-price {
    color: #f5f5f5;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .merch-footer {
    margin-top: 35px;
    color: #737373;
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-align: right;
  }

  .merch-message {
    padding: 30px 0;
    color: #a3a3a3;
  }

  @media (max-width: 850px) {
    .merch-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .merch-section {
      padding: 70px 20px;
    }

    .merch-grid {
      grid-template-columns: 1fr;
    }

    .merch-image {
      height: 260px;
    }
  }
</style>
