
---
const redes = [
  {
    nombre: 'Instagram',
    descripcion: 'Fotografías, novedades y contenido visual.',
    url: 'https://www.instagram.com/museband/',
    etiqueta: 'INSTAGRAM'
  },
  {
    nombre: 'YouTube',
    descripcion: 'Videoclips, presentaciones y contenido audiovisual.',
    url: 'https://www.youtube.com/muse',
    etiqueta: 'YOUTUBE'
  },
  {
    nombre: 'Facebook',
    descripcion: 'Noticias y publicaciones de la banda.',
    url: 'https://www.facebook.com/muse/',
    etiqueta: 'FACEBOOK'
  },
  {
    nombre: 'X',
    descripcion: 'Actualizaciones y anuncios.',
    url: 'https://x.com/Musetheband',
    etiqueta: 'X'
  }
];
---

<section id="comunidad" class="community-section">
  <div class="community-container">
    <div class="section-heading">
      <span class="section-label">SEGUÍ A MUSE</span>
      <h2>Comunidad</h2>
      <p>
        La música continúa más allá del escenario.
        Conectá con Muse a través de sus canales oficiales.
      </p>
    </div>

    <div class="social-grid">
      {redes.map((red) => (
        <a
          href={red.url}
          class="social-card"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visitar Muse en ${red.nombre}`}
        >
          <span class="social-label">{red.etiqueta}</span>
          <h3>{red.nombre}</h3>
          <p>{red.descripcion}</p>
          <span class="social-link">
            Visitar perfil <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .community-section {
    padding: 100px 6%;
    background: #101b2d;
    color: #f5f5f5;
  }

  .community-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-heading {
    max-width: 650px;
    margin-bottom: 45px;
  }

  .section-label {
    display: block;
    color: #e31b23;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0 0 14px;
  }

  .section-heading p {
    color: #b8c2d0;
    line-height: 1.7;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .social-card {
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 26px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: #f5f5f5;
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s,
      transform 0.25s;
  }

  .social-card:hover {
    border-color: #e31b23;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-5px);
  }

  .social-label {
    color: #8da9cc;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .social-card h3 {
    font-size: 1.5rem;
    margin: 22px 0 10px;
  }

  .social-card p {
    color: #a3a3a3;
    line-height: 1.6;
    font-size: 0.9rem;
  }

  .social-link {
    margin-top: auto;
    padding-top: 20px;
    color: #f5f5f5;
    font-weight: 600;
  }

  .social-card:hover .social-link {
    color: #e31b23;
  }

  @media (max-width: 900px) {
    .social-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 550px) {
    .community-section {
      padding: 70px 5%;
    }

    .social-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
